
{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Database": {
    "MigrateOnStartup": true
  },

  "BackgroundJobs": {
    "Enabled": true,
    "InitialDelaySeconds": 120,
    "IntervalHours": 24,
    "BatchSize": 10,
    "MaxBatchesPerRun": 2
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
